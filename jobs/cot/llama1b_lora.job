#!/bin/bash -l

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --time=36:00:00
#SBATCH --job-name=llama1b_lora
#SBATCH --output=job_logs/cot/llama1b_lora-%A.out

cd "$HOME/GateSkip"

. jobs/environment.sh

## Baseline fine-tuning with LoRA
