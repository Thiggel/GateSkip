#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --time=6:00:00
#SBATCH --job-name=llama1b_layerskip
#SBATCH --output=job_logs/cot/llama1b_layerskip-%A.out

cd $HOME/GateSkip

. jobs/environment.sh

#srun python -m experiment \
#  --model-name "meta-llama/Llama-3.2-1B" \
#  --dataset csqa_gsm8k_gen \
#  --pretrained \
#  --use-early-exit \
#  --early-exit-method layerskip \
#  --layer-skip-dropout 0.1 \
