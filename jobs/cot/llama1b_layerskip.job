#  --project-name gateskip \
#  --enable-logging

srun python -m experiment \
  --model-name "meta-llama/Llama-3.2-1B" \
  --pretrained \
  --use-early-exit \
  --early-exit-method layerskip \
  --layer-skip-dropout 0.0 \
  --free-shallow-layers 0 6 \
  --eval-batch-size 16 \
  --seq-length 4096 \
  --finetune-mode full \
  --mode evaluate \
  --evaluation-metrics csqa_gen,gsm8k,piqa_gen \
  --num-fewshot 0 \
  --experiment-name llama1b_layerskip \
  --load-from-checkpoint llama1b_layerskip \
  --project-name gateskip
