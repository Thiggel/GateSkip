#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --time=12:00:00
#SBATCH --job-name=llama3b_instruct_gateskip_frozen
#SBATCH --output=job_logs/frozen/loglikelihood/llama3b_instruct_gateskip_frozen-%A.out

cd $HOME/GateSkip

. jobs/environment.sh

