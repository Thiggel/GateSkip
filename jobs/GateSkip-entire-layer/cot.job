#!/bin/bash -l

#SBATCH --job-name=GateSkip-entire-layer
#SBATCH --output=job_logs/GateSkip-entire-layer/cot_%j.txt
#SBATCH --partition=a100
#SBATCH --gres=gpu:a100:1 -C a100_80
#SBATCH --time=23:00:00
#SBATCH --nodes=1

cd "$HOME/GateSkip"

. jobs/environment.sh
. jobs/job_common.sh

run_job "GateSkip-entire-layer" "cot" "GateSkip-entire-layer"
