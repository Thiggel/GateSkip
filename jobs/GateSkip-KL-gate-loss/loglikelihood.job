#!/bin/bash -l

#SBATCH --job-name=GateSkip-KL-gate-loss
#SBATCH --output=job_logs/GateSkip-KL-gate-loss/loglikelihood_%j.txt
#SBATCH --partition=a100
#SBATCH --gres=gpu:a100:1 -C a100_80
#SBATCH --time=23:00:00
#SBATCH --nodes=1

cd "$HOME/GateSkip"

. jobs/environment.sh
. jobs/job_common.sh

run_job "GateSkip-KL-gate-loss" "loglikelihood" "GateSkip-KL-gate-loss"
