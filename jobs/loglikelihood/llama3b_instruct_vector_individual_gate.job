#!/bin/bash -l

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --time=06:30:00
#SBATCH --job-name=llama3b_instruct_vector_individual_gate_loglikelihood
#SBATCH --output=job_logs/loglikelihood/llama3b_instruct_vector_individual_gate_loglikelihood-%A.out

cd "$HOME/GateSkip"

. jobs/environment.sh

