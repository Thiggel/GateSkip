srun python -m experiment \
  --model-name "meta-llama/Llama-3.2-1B" \
  --pretrained \
  --use-early-exit \
  --early-exit-method free \
  --use-free-distillation \
  --use-free-speculative-decoding \
  --free-shallow-layers 0 6 \
  --confidence-measure softmax \
  --eval-batch-size 64\
  --seq-length 4096 \
  --finetune-mode full \
  --mode evaluate \
  --evaluation-metrics commonsense_qa,piqa,mmlu_stem,hellaswag,winogrande,openbookqa,squadv2 \
  --num-fewshot 0 \
  --experiment-name llama1b_free_loglikelihood_softmax \
  --load-from-checkpoint llama1b_free_loglikelihood \
  --project-name gateskip

