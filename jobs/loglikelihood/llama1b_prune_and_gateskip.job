#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --time=03:30:00
#SBATCH --job-name=llama1b_prune_and_gateskip
#SBATCH --output=job_logs/loglikelihood/llama1b_prune_and_gateskip-%A.out

cd $HOME/GateSkip

. jobs/environment.sh

PRUNED_DIR=$HOME/pruned_llama1b_shortgpt
CALIB_TEXT=$HOME/calibration_text.txt
CHECKPOINT=$HOME/my_finetuned.ckpt

python shortgpt_prune.py "meta-llama/Llama-3.2-1B" "$CALIB_TEXT" "$PRUNED_DIR" \
  --seq_len 512 --batch_size 1 --prune_ratio 0.25 \
  --checkpoint "$CHECKPOINT"

srun python -m experiment \
  --model-name "$PRUNED_DIR" \
  --pretrained \
  --use-gating \
  --skip-modules \
  --eval-batch-size 128 \
  --seq-length 4096 \
  --finetune-mode full \
  --mode evaluate \
  --evaluation-metrics commonsense_qa,piqa,mmlu_stem,hellaswag,winogrande,openbookqa,squadv2 \
  --num-fewshot 0 \
  --experiment-name llama1b_pruned_gate \
  --project-name gateskip

